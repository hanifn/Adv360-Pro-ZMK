#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

// ──────────────────────────────────────────────────────────────
// Layer indices
// ──────────────────────────────────────────────────────────────
#define U_BASE   0
#define U_EXTRA  1
#define U_TAP    2
#define U_BUTTON 3
#define U_NAV    4
#define U_MOUSE  5
#define U_MEDIA  6
#define U_NUM    7
#define U_SYM    8
#define U_FUN    9
#define U_MOD    10

// ──────────────────────────────────────────────────────────────
// Convenience defines
// ──────────────────────────────────────────────────────────────
#define HYPER LS(LC(LA(LGUI)))

// Mac clipboard shortcuts
#define U_RDO &kp LS(LG(Z))
#define U_PST &kp LG(V)
#define U_CPY &kp LG(C)
#define U_CUT &kp LG(X)
#define U_UND &kp LG(Z)

// Mouse movement
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_U &mmv MOVE_UP
#define U_MS_R &mmv MOVE_RIGHT

// Mouse scroll
#define U_WH_L &msc SCRL_LEFT
#define U_WH_D &msc SCRL_DOWN
#define U_WH_U &msc SCRL_UP
#define U_WH_R &msc SCRL_RIGHT

// Mouse buttons
#define U_BTN1 &mkp MB1
#define U_BTN2 &mkp MB2
#define U_BTN3 &mkp MB3

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        // Homerow mod: tap-preferred, with prior-idle guard
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "U_MT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer-tap: balanced flavor
        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "U_LT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // ── Shift functions (Miryoku) ─────────────────────────────
        // caps_word on tap, CAPS on shift
        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            label = "U_CAPS_WORD";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // OUT_TOG on tap, OUT_USB on shift
        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            label = "U_OUT_TOG";
            #binding-cells = <0>;
            bindings = <&out OUT_TOG>, <&out OUT_USB>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // BT_SEL macros (select + clear on shift)
        u_macro_bt_sel_0: u_macro_bt_sel_0 {
            compatible = "zmk,behavior-macro";
            label = "U_MACRO_BT_SEL_0";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };
        u_macro_bt_sel_1: u_macro_bt_sel_1 {
            compatible = "zmk,behavior-macro";
            label = "U_MACRO_BT_SEL_1";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
        };
        u_macro_bt_sel_2: u_macro_bt_sel_2 {
            compatible = "zmk,behavior-macro";
            label = "U_MACRO_BT_SEL_2";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 2>, <&bt BT_CLR>;
        };
        u_macro_bt_sel_3: u_macro_bt_sel_3 {
            compatible = "zmk,behavior-macro";
            label = "U_MACRO_BT_SEL_3";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 3>, <&bt BT_CLR>;
        };
        u_macro_bt_sel_4: u_macro_bt_sel_4 {
            compatible = "zmk,behavior-macro";
            label = "U_MACRO_BT_SEL_4";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 4>, <&bt BT_CLR>;
        };

        // BT profile mod-morphs: select on tap, select+clear on shift
        u_bt_sel_0: u_bt_sel_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_0";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&u_macro_bt_sel_0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_1: u_bt_sel_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_1";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&u_macro_bt_sel_1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_2: u_bt_sel_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_2";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&u_macro_bt_sel_2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_3: u_bt_sel_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_3";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&u_macro_bt_sel_3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_4: u_bt_sel_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "U_BT_SEL_4";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4>, <&u_macro_bt_sel_4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ══════════════════════════════════════════════════════════════════════════════
        // Physical layout — 76 keys, 5 rows. Each binding row below = one keyboard row.
        // Column widths are fixed across all layers so positions align vertically.
        // Sections within a row: LEFT  ····  THUMB  ····  RIGHT
        // ══════════════════════════════════════════════════════════════════════════════

        // ── 0: BASE — QWERTY + homerow mods ─────────────────────────────
        base_layer {
            display-name = "Base";
            bindings = <
// Row 1
&kp EQUAL       &kp N1            &kp N2        &kp N3         &kp N4         &kp N5           &tog U_TAP                                                                                                        &mo U_MOD     &kp N6           &kp N7           &kp N8           &kp N9           &kp N0                &kp MINUS
// Row 2
&kp GRAVE       &kp Q             &kp W         &kp E          &kp R          &kp T            &kp LBKT                                                                                                          &kp RBKT      &kp Y            &kp U            &kp I            &kp O            &kp P                 &kp BSLH
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&kp LCTRL       &u_mt LGUI A      &u_mt LALT S  &u_mt LCTRL D  &u_mt LSHFT F  &kp G            &kp LPAR                        &u_lt U_MEDIA ESC  &u_caps_word  &kp LGUI    &u_lt U_FUN DEL                      &kp RPAR      &kp H            &u_mt LSHFT J    &u_mt LCTRL K    &u_mt LALT L     &u_mt LGUI SEMI       &kp SQT
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&kp LSHFT       &u_lt U_BUTTON Z  &u_mt RALT X  &kp C          &kp V          &kp B                                                               &kp HOME      &kp PG_UP                                                      &kp N            &kp M            &kp COMMA        &u_mt RALT DOT   &u_lt U_BUTTON SLASH  &kp RSHFT
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&mo U_FUN       &kp HYPER         &kp LALT      &kp LEFT       &kp RIGHT                                      &u_lt U_NAV SPC  &u_lt U_MOUSE TAB  &kp END       &kp PG_DN   &u_lt U_SYM RET  &u_lt U_NUM BSPC                                   &kp UP           &kp DOWN         &kp RALT         &kp HYPER             &mo U_FUN
            >;
        };

        // ── 1: EXTRA — Colemak-DH + homerow mods ────────────────────────
        extra_layer {
            display-name = "Extra";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &kp Q             &kp W         &kp F          &kp P          &kp B            &trans                                                                                                            &trans        &kp J            &kp L            &kp U            &kp Y            &kp SQT               &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &u_mt LGUI A      &u_mt LALT R  &u_mt LCTRL S  &u_mt LSHFT T  &kp G            &trans                          &u_lt U_MEDIA ESC  &u_caps_word  &kp LGUI    &u_lt U_FUN DEL                      &trans        &kp M            &u_mt LSHFT N    &u_mt LCTRL E    &u_mt LALT I     &u_mt LGUI O          &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &u_lt U_BUTTON Z  &u_mt RALT X  &kp C          &kp D          &kp V                                                               &trans        &trans                                                         &kp K            &kp H            &kp COMMA        &u_mt RALT DOT   &u_lt U_BUTTON SLASH  &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &u_lt U_NAV SPC  &u_lt U_MOUSE TAB  &trans        &trans      &u_lt U_SYM RET  &u_lt U_NUM BSPC                                   &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 2: TAP — plain QWERTY, no mods ──────────────────────────────
        tap_layer {
            display-name = "Tap";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &kp Q             &kp W         &kp E          &kp R          &kp T            &trans                                                                                                            &trans        &kp Y            &kp U            &kp I            &kp O            &kp P                 &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp A             &kp S         &kp D          &kp F          &kp G            &trans                          &kp ESC            &u_caps_word  &kp LGUI    &kp DEL                              &trans        &kp H            &kp J            &kp K            &kp L            &kp SEMI              &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &kp Z             &kp X         &kp C          &kp V          &kp B                                                               &trans        &trans                                                         &kp N            &kp M            &kp COMMA        &kp DOT          &kp SLASH             &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &kp SPC          &kp TAB            &trans        &trans      &kp RET          &kp BSPC                                           &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 3: BUTTON — mouse buttons + clipboard ───────────────────────
        button_layer {
            display-name = "Button";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          U_UND             U_CUT         U_CPY          U_PST          U_RDO            &trans                                                                                                            &trans        U_RDO            U_PST            U_CPY            U_CUT            U_UND                 &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp LGUI          &kp LALT      &kp LCTRL      &kp LSHFT      &none            &trans                          U_BTN3             &trans        &trans      U_BTN3                               &trans        &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI              &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          U_UND             U_CUT         U_CPY          U_PST          U_RDO                                                               &trans        &trans                                                         U_RDO            U_PST            U_CPY            U_CUT            U_UND                 &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         U_BTN1           U_BTN2             &trans        &trans      U_BTN2           U_BTN1                                             &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 4: NAV — VI navigation + Mac clipboard ──────────────────────
        nav_layer {
            display-name = "Nav";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &bootloader       &to U_TAP     &to U_EXTRA    &to U_BASE     &none            &trans                                                                                                            &trans        U_RDO            U_PST            U_CPY            U_CUT            U_UND                 &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp LGUI          &kp LALT      &kp LCTRL      &kp LSHFT      &none            &trans                          &none              &trans        &trans      &kp DEL                              &trans        &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &u_caps_word          &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &none             &kp RALT      &none          &none          &none                                                               &trans        &trans                                                         &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp INS               &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &none            &none              &trans        &trans      &kp RET          &kp BSPC                                           &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 5: MOUSE — pointer + scroll ─────────────────────────────────
        mouse_layer {
            display-name = "Mouse";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &bootloader       &to U_TAP     &to U_EXTRA    &to U_BASE     &none            &trans                                                                                                            &trans        U_RDO            U_PST            U_CPY            U_CUT            U_UND                 &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp LGUI          &kp LALT      &kp LCTRL      &kp LSHFT      &none            &trans                          &none              &trans        &trans      U_BTN3                               &trans        &none            U_MS_L           U_MS_D           U_MS_U           U_MS_R                &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &none             &kp RALT      &none          &none          &none                                                               &trans        &trans                                                         &none            U_WH_L           U_WH_D           U_WH_U           U_WH_R                &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &none            &none              &trans        &trans      U_BTN2           U_BTN1                                             &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 6: MEDIA — media + RGB/BT controls ──────────────────────────
        media_layer {
            display-name = "Media";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &bootloader       &to U_TAP     &to U_EXTRA    &to U_BASE     &none            &trans                                                                                                            &trans        &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI       &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp LGUI          &kp LALT      &kp LCTRL      &kp LSHFT      &none            &trans                          &none              &trans        &trans      &kp C_MUTE                           &trans        &none            &kp C_PREV       &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT            &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &none             &kp RALT      &none          &none          &none                                                               &trans        &trans                                                         &u_out_tog       &u_bt_sel_0      &u_bt_sel_1      &u_bt_sel_2      &u_bt_sel_3           &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &none            &none              &trans        &trans      &kp C_STOP       &kp C_PP                                           &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 7: NUM — numpad ─────────────────────────────────────────────
        num_layer {
            display-name = "Num";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &kp LBKT          &kp N7        &kp N8         &kp N9         &kp RBKT         &trans                                                                                                            &trans        &none            &to U_BASE       &to U_EXTRA      &to U_TAP        &bootloader           &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp SEMI          &kp N4        &kp N5         &kp N6         &kp EQUAL        &trans                          &kp DOT            &trans        &trans      &none                                &trans        &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI              &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &kp GRAVE         &kp N1        &kp N2         &kp N3         &kp BSLH                                                            &trans        &trans                                                         &none            &none            &none            &kp RALT         &none                 &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &kp N0           &kp MINUS          &trans        &trans      &none            &none                                              &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 8: SYM — symbols ────────────────────────────────────────────
        sym_layer {
            display-name = "Sym";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &kp LBRC          &kp AMPS      &kp ASTRK      &kp LPAR       &kp RBRC         &trans                                                                                                            &trans        &none            &to U_BASE       &to U_EXTRA      &to U_TAP        &bootloader           &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp COLON         &kp DLLR      &kp PRCNT      &kp CARET      &kp PLUS         &trans                          &kp LPAR           &trans        &trans      &none                                &trans        &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI              &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &kp TILDE         &kp EXCL      &kp AT         &kp HASH       &kp PIPE                                                            &trans        &trans                                                         &none            &none            &none            &kp RALT         &none                 &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &kp RPAR         &kp UNDER          &trans        &trans      &none            &none                                              &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 9: FUN — function keys ──────────────────────────────────────
        fun_layer {
            display-name = "Fun";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &kp F12           &kp F7        &kp F8         &kp F9         &kp PSCRN        &trans                                                                                                            &trans        &none            &to U_BASE       &to U_EXTRA      &to U_TAP        &bootloader           &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&trans          &kp F11           &kp F4        &kp F5         &kp F6         &kp SLCK         &trans                          &kp K_APP          &trans        &trans      &none                                &trans        &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI              &trans
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &kp F10           &kp F1        &kp F2         &kp F3         &kp PAUSE_BREAK                                                     &trans        &trans                                                         &none            &none            &none            &kp RALT         &none                 &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &kp SPC          &kp TAB            &trans        &trans      &none            &none                                              &trans           &trans           &trans           &trans                &trans
            >;
        };

        // ── 10: MOD — BT / RGB / backlight ──────────────────────────────
        mod_layer {
            display-name = "Mod";
            bindings = <
// Row 1
&trans          &trans            &trans        &trans         &trans         &trans           &trans                                                                                                            &trans        &trans           &trans           &trans           &trans           &trans                &trans
// Row 2
&trans          &u_bt_sel_0       &u_bt_sel_1   &u_bt_sel_2    &u_bt_sel_3    &u_bt_sel_4      &bootloader                                                                                                       &bootloader   &none            &none            &none            &none            &none                 &trans
// Row 3: ····· homerow ·············  thumb-upper  ············· homerow ·····
&studio_unlock  &none             &none         &none          &none          &none            &none                           &none              &none         &bt BT_CLR  &none                                &stp STP_BAT  &rgb_ug RGB_TOG  &none            &none            &none            &none                 &none
// Row 4: ····· bottom ··············  thumb-mid  ··············· bottom ·······
&trans          &none             &none         &none          &macro_ver     &none                                                               &none         &none                                                          &bl BL_TOG       &bl BL_INC       &bl BL_DEC       &none            &none                 &trans
// Row 5: ···· outer ·············  thumb-cluster  ·············· outer ········
&trans          &trans            &trans        &trans         &trans                                         &trans           &trans             &trans        &trans      &trans           &trans                                             &trans           &trans           &trans           &trans                &trans
            >;
        };
    };
};

